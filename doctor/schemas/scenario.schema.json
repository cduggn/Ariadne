{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Fault scenario (answer key)",
  "type": "object",
  "required": [
    "allowed",
    "also_ok",
    "apply",
    "category",
    "cluster",
    "evidence",
    "forbidden",
    "hints",
    "id",
    "live_only",
    "must_call",
    "namespace",
    "objects",
    "red_herrings",
    "report",
    "task_type",
    "tier",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
      "description": "Kubernetes namespace"
    },
    "title": {
      "type": "string"
    },
    "report": {
      "type": "string",
      "description": "what a user would say; shown to the model"
    },
    "category": {
      "enum": [
        "crashloop_app_error",
        "oom_killed",
        "image_pull",
        "unschedulable_resources",
        "unschedulable_constraints",
        "probe_failure",
        "service_no_endpoints",
        "service_misconfig",
        "config_missing",
        "dependency_missing",
        "dns_failure",
        "tls_trust",
        "tls_expired",
        "cpu_throttling",
        "ephemeral_storage",
        "resource_policy",
        "job_failed",
        "rollout_stuck",
        "overprovisioned",
        "gpu_slice_oom",
        "gpu_unavailable",
        "kv_saturation",
        "runaway_cost",
        "other",
        "healthy"
      ]
    },
    "allowed": {
      "type": "array",
      "items": {
        "enum": [
          "crashloop_app_error",
          "oom_killed",
          "image_pull",
          "unschedulable_resources",
          "unschedulable_constraints",
          "probe_failure",
          "service_no_endpoints",
          "service_misconfig",
          "config_missing",
          "dependency_missing",
          "dns_failure",
          "tls_trust",
          "tls_expired",
          "cpu_throttling",
          "ephemeral_storage",
          "resource_policy",
          "job_failed",
          "rollout_stuck",
          "overprovisioned",
          "gpu_slice_oom",
          "gpu_unavailable",
          "kv_saturation",
          "runaway_cost",
          "other",
          "healthy"
        ]
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "affects"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "affects": {
            "type": "array"
          },
          "alternatives": {
            "type": "array"
          },
          "resize_band": {
            "type": "object",
            "properties": {
              "cpu_m": {
                "type": "array"
              },
              "memory_mi": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "enum": [
          "status",
          "event",
          "describe",
          "log",
          "resources",
          "metrics",
          "certificate",
          "rightsizing",
          "cost"
        ]
      }
    },
    "must_call": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "live_only": {
      "type": "boolean"
    },
    "apply": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cluster": {
      "type": "string"
    },
    "settle": {
      "type": [
        "string",
        "array"
      ]
    },
    "tier": {
      "enum": [
        "easy",
        "multi_hop",
        "red_herring",
        "rightsizing",
        "live"
      ]
    },
    "task_type": {
      "enum": [
        "investigate",
        "audit",
        "rightsize"
      ]
    },
    "red_herrings": {
      "type": "array",
      "description": "objects that look broken but are not the cause; a finding on them is a false positive"
    },
    "also_ok": {
      "type": "array",
      "description": "objects a finding may name without being a false positive (optionally limited to categories)"
    },
    "forbidden": {
      "type": "array",
      "description": "traps: a finding on this object with one of these categories fails"
    },
    "hints": {
      "type": "object",
      "description": "reference-solver hints only; never shown to the model"
    },
    "tls_setup": {
      "type": "array"
    },
    "usage_window_s": {
      "type": "integer"
    }
  }
}
