    }
  },
  {
    "type": "function",
    "function": {
      "name": "s3_bucket_stats",
      "description": "Object count and total bytes of the configured lab S3 bucket (read-only). Only for cost or storage questions.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
          }
        },
        "required": [
          "bucket"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "cost_report",
      "description": "Cost data: aws_by_service_7d and aws_anomalies_30d from AWS Cost Explorer (about one day behind); cluster_by_namespace_24h from OpenCost (same day). Only for cost questions.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "enum": [
              "aws_by_service_7d",
              "aws_anomalies_30d",
              "cluster_by_namespace_24h"
            ]
          }
        },
        "required": [
          "query"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_diagnosis",
      "description": "Submit the diagnosis once. Each finding names the object to change, its category, the root cause, evidence refs copied from tool results, and a suggested fix you do not apply. If nothing is wrong, status healthy with no findings. If it returns accepted:false, fix the listed problems and submit again.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "issue",
              "healthy"
            ]
          },
          "findings": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "namespace",
                "kind",
                "name",
                "root_cause",
                "evidence",
                "fix",
                "confidence"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "crashloop_app_error",
                    "oom_killed",
                    "image_pull",
                    "unschedulable_resources",
                    "unschedulable_constraints",
                    "probe_failure",
                    "service_no_endpoints",
                    "config_missing",
                    "job_failed",
                    "rollout_stuck",
                    "gpu_slice_oom",
                    "gpu_unavailable",
                    "kv_saturation",
                    "runaway_cost",
                    "other"
                  ]
                },
                "namespace": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
                  "description": "Kubernetes namespace"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Pod",
                    "Deployment",
                    "ReplicaSet",
                    "Service",
                    "Job",
                    "ConfigMap",
                    "Node"
                  ]
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
                  "description": "the object whose spec or config must change (usually the Deployment, Job or Service, not the pod)"
                },
                "root_cause": {
                  "type": "string",
                  "maxLength": 240
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": {
                    "type": "string",
                    "pattern": "^(st|ev|ds|lg|rs|mt|cs)-[a-z0-9][-a-z0-9._]*$"
                  },
                  "description": "refs copied exactly from tool results"
                },
                "fix": {
                  "type": "string",
                  "maxLength": 240,
                  "description": "suggested change; never applied by you"
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              }
            }
          },
          "summary": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "status",
          "findings",
          "summary"
        ]
      }
    }
  }
]
