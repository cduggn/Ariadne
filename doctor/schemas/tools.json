        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "preset": {
            "type": "string",
            "enum": [
              "pods",
              "vllm_kv",
              "vllm_queue",
              "vllm_preemptions",
              "gpu_util",
              "gpu_memory"
            ]
          }
        },
        "required": [
