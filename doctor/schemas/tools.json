              "deployments",
              "services",
              "jobs",
              "pods",
              "configmaps"
            ]
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          }
        },
        "required": [
          "kind",
          "namespace"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "resource_usage",
      "description": "Live usage: preset \"pods\" = CPU/memory per pod; vllm_* and gpu_* presets read inference-server and GPU metrics where the cluster has them.",
      "strict": true,
      "parameters": {
