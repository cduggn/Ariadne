[
  {
    "type": "function",
    "function": {
      "name": "list_problem_pods",
      "description": "Pods in a namespace that are not healthy (not Running/Ready, restarting, waiting or pending), each with a status ref, reason, restarts and owning workload.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          }
        },
        "required": [
          "namespace"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_events",
      "description": "Recent Kubernetes events in a namespace, warnings first, each with a ref. object_name filters by name prefix; use \"any\" for all.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "object_name": {
            "type": "string",
            "pattern": "^(any|[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "namespace",
          "object_name",
          "limit"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "describe",
      "description": "Condensed spec and status of one object: containers, probes, resources, env sources and conditions for a pod; replicas and rollout conditions for a deployment; selector, matching pods and ready endpoints for a service; retries and conditions for a job; capacity and taints for a node.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "pod",
              "deployment",
              "replicaset",
              "service",
              "job",
              "node"
            ]
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
          }
        },
        "required": [
          "kind",
          "namespace",
          "name"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "pod_logs",
      "description": "Last lines of a pod's first container, each line with a ref. previous=true reads the container instance that crashed before the current one (may be unavailable).",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "pod": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
          },
          "previous": {
            "type": "boolean"
          },
          "tail": {
            "type": "integer",
            "minimum": 1,
            "maximum": 80
          }
        },
        "required": [
          "namespace",
          "pod",
          "previous",
          "tail"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
