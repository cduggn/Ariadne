{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnosis.schema.json",
  "title": "Diagnosis",
  "description": "What submit_diagnosis must produce: one finding per root cause, grounded in evidence refs that tools returned to the model in this run (checked against the observation ledger, D-41).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "findings",
    "summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "issue",
        "healthy",
        "inconclusive"
      ],
      "description": "issue: at least one grounded finding \u00b7 healthy: checked (list_problem_pods for every namespace) and nothing is wrong \u00b7 inconclusive: you could not ground a diagnosis; no findings, and say in summary what you could not check"
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "namespace",
          "kind",
          "name",
          "root_cause",
          "affects",
          "evidence",
          "fix",
          "resize",
          "confidence"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "crashloop_app_error",
              "oom_killed",
              "image_pull",
              "unschedulable_resources",
              "unschedulable_constraints",
              "probe_failure",
              "service_no_endpoints",
              "service_misconfig",
              "config_missing",
              "dependency_missing",
              "dns_failure",
              "tls_trust",
              "tls_expired",
              "cpu_throttling",
              "ephemeral_storage",
              "resource_policy",
              "job_failed",
              "rollout_stuck",
              "overprovisioned",
              "gpu_slice_oom",
              "gpu_unavailable",
              "kv_saturation",
              "runaway_cost",
              "other"
            ]
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "kind": {
            "type": "string",
            "enum": [
              "Pod",
              "Deployment",
              "ReplicaSet",
              "Service",
              "Job",
              "ConfigMap",
              "LimitRange",
              "ResourceQuota",
              "NetworkPolicy",
              "PersistentVolumeClaim",
              "Ingress",
              "Node"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
            "description": "the ROOT CAUSE object \u2014 the one whose spec or config must change"
          },
          "root_cause": {
            "type": "string",
            "maxLength": 300,
            "description": "the causal chain in one or two sentences: symptom \u2192 \u2026 \u2192 cause"
          },
          "affects": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "namespace",
                "name"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "Pod",
                    "Deployment",
                    "ReplicaSet",
                    "Service",
                    "Job",
                    "ConfigMap",
                    "LimitRange",
                    "ResourceQuota",
                    "NetworkPolicy",
                    "PersistentVolumeClaim",
                    "Ingress",
                    "Node"
                  ]
                },
                "namespace": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
                  "description": "Kubernetes namespace"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
                }
              }
            },
            "description": "other objects that show symptoms caused by this root (victims); empty if none"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^(st|ev|ds|lg|rs|mt|ct|rz|cs)-[a-z0-9][-a-z0-9._]*$"
            },
            "description": "refs copied exactly from tool results, covering the chain"
          },
          "fix": {
            "type": "string",
            "maxLength": 240,
            "description": "suggested change; never applied by you"
          },
          "resize": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cpu_request",
              "memory_request"
            ],
            "description": "for overprovisioned findings: the new requests (e.g. 50m, 64Mi); otherwise empty strings",
            "properties": {
              "cpu_request": {
                "type": "string",
                "pattern": "^$|^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
              },
              "memory_request": {
                "type": "string",
                "pattern": "^$|^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
              }
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    }
  }
}
