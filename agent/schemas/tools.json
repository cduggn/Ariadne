[
  {
    "type": "function",
    "function": {
      "name": "list_problem_pods",
      "description": "Pods in a namespace that are not healthy (not Running/Ready, restarting, waiting, pending, evicted or stuck in init), each with a status ref, reason, restarts and owning workload.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          }
        },
        "required": [
          "namespace"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_events",
      "description": "Recent Kubernetes events in a namespace, warnings first, each with a ref. object_name filters by name prefix (a Deployment name also matches its ReplicaSets and pods); use \"any\" for all.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "object_name": {
            "type": "string",
            "pattern": "^(any|[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "namespace",
          "object_name",
          "limit"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "describe",
      "description": "Condensed spec and status of one object. pod: containers (ports, resources, probes, env names, mounts), init containers, volumes, DNS config, conditions. deployment/replicaset: replicas and rollout conditions. service: selector, ports and targetPorts, matching pods, ready endpoints. job, node, configmap (keys only), limitrange, resourcequota (hard vs used), networkpolicy, persistentvolumeclaim, ingress.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "pod",
              "deployment",
              "replicaset",
              "service",
              "job",
              "node",
              "configmap",
              "limitrange",
              "resourcequota",
              "networkpolicy",
              "persistentvolumeclaim",
              "ingress"
            ]
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
          }
        },
        "required": [
          "kind",
          "namespace",
          "name"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "pod_logs",
      "description": "Last lines of one container of a pod, each line with a ref. container \"\" = the first app container; name an init container or sidecar explicitly. previous=true reads the instance that crashed before the current one (may be unavailable).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "pod": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
          },
          "container": {
            "type": "string",
            "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "previous": {
            "type": "boolean"
          },
          "tail": {
            "type": "integer",
            "minimum": 1,
            "maximum": 80
          }
        },
        "required": [
          "namespace",
          "pod",
          "container",
          "previous",
          "tail"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_resources",
      "description": "Names and one-line status of objects of one kind in a namespace (configmaps: keys only, never values; services: ports as port->targetPort).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "deployments",
              "services",
              "jobs",
              "pods",
              "configmaps",
              "limitranges",
              "resourcequotas",
              "networkpolicies",
              "persistentvolumeclaims",
              "ingresses"
            ]
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          }
        },
        "required": [
          "kind",
          "namespace"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "resource_usage",
      "description": "Current usage: preset \"pods\" = CPU/memory per container; vllm_* and gpu_* presets read inference-server and GPU metrics where the cluster has them.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "preset": {
            "type": "string",
            "enum": [
              "pods",
              "vllm_kv",
              "vllm_queue",
              "vllm_preemptions",
              "gpu_util",
              "gpu_memory"
            ]
          }
        },
        "required": [
          "namespace",
          "preset"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "inspect_certificate",
      "description": "Subject, issuer, validity (expired? days left), DNS names and CA flag of a PUBLIC certificate stored in a ConfigMap key (e.g. a CA bundle ca.crt or a published tls.crt). Secrets are never readable.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          },
          "configmap": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
          },
          "key": {
            "type": "string",
            "pattern": "^[-._a-zA-Z0-9]+$"
          }
        },
        "required": [
          "namespace",
          "configmap",
          "key"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "rightsizing",
      "description": "Per workload container: CPU/memory requests and limits against observed usage (p50/p95/max over the sampled window), share of samples at the CPU limit (throttling), idle request and an estimated monthly cost of it.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
            "description": "Kubernetes namespace"
          }
        },
        "required": [
          "namespace"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "s3_bucket_stats",
      "description": "Object count and total bytes of the configured lab S3 bucket (read-only). Only for cost or storage questions.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
          }
        },
        "required": [
          "bucket"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "cost_report",
      "description": "Cost data: aws_by_service_7d and aws_anomalies_30d from AWS Cost Explorer (about one day behind); cluster_by_namespace_24h from OpenCost (same day). Only for cost questions.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "enum": [
              "aws_by_service_7d",
              "aws_anomalies_30d",
              "cluster_by_namespace_24h"
            ]
          }
        },
        "required": [
          "query"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "submit_diagnosis",
      "description": "Submit once. One finding per ROOT CAUSE: name the object to change, its category, the causal chain, the victims in `affects`, evidence refs copied from tool results, and a fix you do not apply. Do not file separate findings for victims. If nothing is wrong (after list_problem_pods for every namespace): status healthy, no findings. If you cannot ground a diagnosis: status inconclusive, no findings, and say in summary what you could not check. If it returns accepted:false, fix the listed problems and submit again.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "issue",
              "healthy",
              "inconclusive"
            ],
            "description": "issue: at least one grounded finding \u00b7 healthy: checked (list_problem_pods for every namespace) and nothing is wrong \u00b7 inconclusive: you could not ground a diagnosis; no findings, and say in summary what you could not check"
          },
          "findings": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "namespace",
                "kind",
                "name",
                "root_cause",
                "affects",
                "evidence",
                "fix",
                "resize",
                "confidence"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "crashloop_app_error",
                    "oom_killed",
                    "image_pull",
                    "unschedulable_resources",
                    "unschedulable_constraints",
                    "probe_failure",
                    "service_no_endpoints",
                    "service_misconfig",
                    "config_missing",
                    "dependency_missing",
                    "dns_failure",
                    "tls_trust",
                    "tls_expired",
                    "cpu_throttling",
                    "ephemeral_storage",
                    "resource_policy",
                    "job_failed",
                    "rollout_stuck",
                    "overprovisioned",
                    "gpu_slice_oom",
                    "gpu_unavailable",
                    "kv_saturation",
                    "runaway_cost",
                    "other"
                  ]
                },
                "namespace": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
                  "description": "Kubernetes namespace"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Pod",
                    "Deployment",
                    "ReplicaSet",
                    "Service",
                    "Job",
                    "ConfigMap",
                    "LimitRange",
                    "ResourceQuota",
                    "NetworkPolicy",
                    "PersistentVolumeClaim",
                    "Ingress",
                    "Node"
                  ]
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
                  "description": "the ROOT CAUSE object \u2014 the one whose spec or config must change"
                },
                "root_cause": {
                  "type": "string",
                  "maxLength": 300,
                  "description": "the causal chain in one or two sentences: symptom \u2192 \u2026 \u2192 cause"
                },
                "affects": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "namespace",
                      "name"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "Pod",
                          "Deployment",
                          "ReplicaSet",
                          "Service",
                          "Job",
                          "ConfigMap",
                          "LimitRange",
                          "ResourceQuota",
                          "NetworkPolicy",
                          "PersistentVolumeClaim",
                          "Ingress",
                          "Node"
                        ]
                      },
                      "namespace": {
                        "type": "string",
                        "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
                        "description": "Kubernetes namespace"
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
                      }
                    }
                  },
                  "description": "other objects that show symptoms caused by this root (victims); empty if none"
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "string",
                    "pattern": "^(st|ev|ds|lg|rs|mt|ct|rz|cs)-[a-z0-9][-a-z0-9._]*$"
                  },
                  "description": "refs copied exactly from tool results, covering the chain"
                },
                "fix": {
                  "type": "string",
                  "maxLength": 240,
                  "description": "suggested change; never applied by you"
                },
                "resize": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cpu_request",
                    "memory_request"
                  ],
                  "description": "for overprovisioned findings: the new requests (e.g. 50m, 64Mi); otherwise empty strings",
                  "properties": {
                    "cpu_request": {
                      "type": "string",
                      "pattern": "^$|^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
                    },
                    "memory_request": {
                      "type": "string",
                      "pattern": "^$|^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
                    }
                  }
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              }
            }
          },
          "summary": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "status",
          "findings",
          "summary"
        ]
      }
    }
  }
]
