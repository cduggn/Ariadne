     "expr": "vGPU_device_memory_limit_in_bytes",
     "legendFormat": "{{podname}} limit"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "GPU power draw and SM activity (prefill vs decode phases)",
   "description": "Rubric: power during compute-bound prefill (audits, long logs) vs memory-bound decode. Watts from DCGM.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 43
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
