   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "GPU utilisation / SM active",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 35
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
