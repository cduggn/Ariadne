{
  "id": "dns-misconfig",
  "live_only": false,
  "cluster": "kind",
  "apply": [
    "manifest.yaml"
  ],
  "task_type": "investigate",
  "red_herrings": [
    {
      "kind": "Deployment",
      "name": "smtp-relay"
    }
  ],
  "also_ok": [],
  "forbidden": [],
  "hints": {
    "log_objects": [
      "mailer"
    ]
  },
  "namespace": "notifications",
  "tier": "red_herring",
  "settle": [
    "restarts>=2"
  ],
  "title": "Pod DNS config points at a nameserver that does not exist",
  "report": "mailer cannot reach smtp-relay. Is the relay down?",
  "category": "dns_failure",
  "allowed": [
    "dns_failure"
  ],
  "objects": [
    {
      "kind": "Deployment",
      "name": "mailer",
      "affects": [],
      "mechanism": {
        "facts": [
          {
            "id": "the pod's DNS config",
            "re": "dns|nameserver|resolv"
          }
        ],
        "example": {
          "root_cause": "mailer's dnsConfig points at nameserver 10.96.0.99, which does not answer, so smtp-relay does not resolve",
          "fix": "remove mailer's custom dnsConfig and use dnsPolicy ClusterFirst"
        }
      }
    }
  ],
  "evidence": [
    "log",
    "describe"
  ],
  "must_call": [
    "pod_logs",
    "describe"
  ]
}
